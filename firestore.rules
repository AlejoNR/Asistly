rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil de cada usuario. Nadie puede cambiar su rol ni su dispositivo vinculado.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['fullName', 'code', 'email', 'role', 'deviceId', 'createdAt'])
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email.matches('.*@udla[.]edu[.]co$')
        // Docente: sin dispositivo. Estudiante: debe reservar su dispositivo
        // en la misma transacción (devices/{deviceId}.uid == su uid).
        && ((request.resource.data.role == 'teacher' && request.resource.data.deviceId == null)
            || (request.resource.data.role == 'student'
                && request.resource.data.deviceId is string
                && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.uid == uid));

      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    // Reserva de dispositivos: un celular = una cuenta de estudiante.
    match /devices/{deviceId} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ================= Cursos, sesiones y asistencia (Asistly) =================
    // Solo se AGREGAN reglas: users y devices quedan igual para no romper AsistlyLogin.

    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function course(courseId) {
      return get(/databases/$(database)/documents/cursos/$(courseId)).data;
    }

    function ownsCourse(courseId) {
      return signedIn() && course(courseId).docenteId == request.auth.uid;
    }

    // Hora de Colombia (UTC-5, sin horario de verano) según el reloj del servidor.
    function bogotaNow() {
      return request.time - duration.value(5, 'h');
    }

    // "08:30" -> 510 minutos desde la medianoche.
    function minutesOf(hhmm) {
      let parts = hhmm.split(':');
      return int(parts[0]) * 60 + int(parts[1]);
    }

    // La fecha "2026-11-03" es la de hoy en Colombia.
    function isToday(dateKey) {
      let t = bogotaNow();
      let parts = dateKey.split('-');
      return int(parts[0]) == t.year() && int(parts[1]) == t.month() && int(parts[2]) == t.day();
    }

    // Un día de clase del curso, desde 15 minutos antes de la hora de inicio hasta
    // la hora de fin (especificación, sección 5). dayOfWeek(): 1 = lunes ... 7 = domingo,
    // igual que el campo "dias" del curso; las pruebas de firestore_tests lo comprueban.
    // La hora es la de ese día en "horarios"; los cursos sin "horarios" usan horaInicio/horaFin.
    function inClassWindow(c) {
      let t = bogotaNow();
      let now = t.hours() * 60 + t.minutes();
      let h = c.get('horarios', {}).get(string(t.dayOfWeek()), {'inicio': c.horaInicio, 'fin': c.horaFin});
      return t.dayOfWeek() in c.dias
        && now >= minutesOf(h.inicio) - 15
        && now <= minutesOf(h.fin);
    }

    // Perfil de quien hace la petición (nombre, código, rol y celular vinculado).
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // El estudiante está en la lista oficial del curso por su código o por su correo.
    function isOnOfficialList(courseId) {
      return exists(/databases/$(database)/documents/cursos/$(courseId)/listaOficial/$(profile().code))
        || exists(/databases/$(database)/documents/cursos/$(courseId)/listaCorreos/$(request.auth.token.email));
    }

    // Datos de una inscripción: nombre, código y correo tienen que ser los del perfil.
    function validEnrollment(uid) {
      let d = request.resource.data;
      return profile().role == 'student'
        && d.keys().hasOnly(['uid', 'nombre', 'codigo', 'correo', 'estado', 'origen', 'fecha', 'retiradoPor'])
        && d.uid == uid
        && d.nombre == profile().fullName
        && d.codigo == profile().code
        && d.correo == request.auth.token.email
        && d.fecha == request.time
        && d.retiradoPor == null;
    }

    // Queda pendiente siempre que quiera; inscrito solo si está en la lista oficial.
    function joinsAsPending() {
      return request.resource.data.estado == 'pendiente' && request.resource.data.origen == 'solicitud';
    }

    function joinsFromList(courseId) {
      return request.resource.data.estado == 'inscrito'
        && request.resource.data.origen == 'lista'
        && isOnOfficialList(courseId);
    }

    // La clase está abierta y el estudiante está inscrito en ese curso.
    function canActInSession(sessionId, uid) {
      let s = get(/databases/$(database)/documents/sesiones/$(sessionId)).data;
      return s.abierta == true
        && profile().role == 'student'
        && get(/databases/$(database)/documents/cursos/$(s.cursoId)/inscripciones/$(uid)).data.estado == 'inscrito';
    }

    // Asistencia del estudiante (especificación, sección 4): dentro del tiempo de registro,
    // desde su celular vinculado y con un código QR vigente. Los códigos se comparan aquí,
    // en el servidor: la app nunca puede leerlos.
    function validStudentAttendance(sessionId, uid) {
      let d = request.resource.data;
      let s = get(/databases/$(database)/documents/sesiones/$(sessionId)).data;
      let t = get(/databases/$(database)/documents/sesiones/$(sessionId)/privado/tokens).data;
      return canActInSession(sessionId, uid)
        && request.time <= s.inicio + duration.value(s.tiempoRegistro, 'm')
        && request.time <= t.actualizadoEn + duration.value(1, 'm')
        && d.keys().hasOnly(['estado', 'hora', 'metodo', 'qr', 'ble', 'rssi', 'deviceId', 'nombre', 'codigo'])
        && d.estado == 'presente'
        && d.hora == request.time
        && d.deviceId == profile().deviceId
        && d.nombre == profile().fullName
        && d.codigo == profile().code
        && (d.qr == t.qrActual || d.qr == t.qrAnterior)
        && validSignal(s, t, d);
    }

    // Si la clase se abrió con "Validar por Bluetooth", además del QR hay que traer
    // el código de la señal que emite el docente (uno del último minuto).
    // Si no, basta el QR. Las sesiones viejas sin el campo cuentan como solo QR.
    function validSignal(s, t, d) {
      return s.get('validarBluetooth', false) == true
        ? d.metodo == 'ble_qr'
          && d.ble is string
          && d.rssi is int
          && d.ble in t.get('bleRecientes', [])
        : d.metodo == 'qr'
          && !('ble' in d)
          && !('rssi' in d);
    }

    // "Mis cursos" del estudiante: busca sus inscripciones en todos los cursos a la vez
    // (consulta collectionGroup; necesita el índice de firestore.indexes.json).
    match /{path=**}/inscripciones/{enrollmentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /cursos/{courseId} {
      // Cualquier usuario con sesión puede leer cursos: el estudiante los busca por código.
      allow read: if signedIn();
      allow create: if isTeacher()
        && request.resource.data.docenteId == request.auth.uid
        && request.resource.data.codigoInscripcion is string;
      // El docente edita su curso, pero no puede cambiar de dueño ni de código.
      allow update: if signedIn()
        && resource.data.docenteId == request.auth.uid
        && request.resource.data.docenteId == resource.data.docenteId
        && request.resource.data.codigoInscripcion == resource.data.codigoInscripcion;
      allow delete: if false;

      // Lista oficial importada: la ve y la edita el docente del curso.
      // El estudiante solo puede consultar su propia fila, para saber si está en la lista.
      match /listaOficial/{studentCode} {
        allow read, write: if ownsCourse(courseId);
        allow get: if signedIn() && studentCode == profile().code;
      }

      // Los mismos correos de la lista, para poder buscar por correo (solo existencia).
      match /listaCorreos/{email} {
        allow read, write: if ownsCourse(courseId);
        allow get: if signedIn() && email == request.auth.token.email;
      }

      // Inscripciones: el docente acepta, retira o rechaza; el estudiante ve la suya,
      // se une con el código del curso y puede salirse.
      match /inscripciones/{uid} {
        allow read: if ownsCourse(courseId) || (signedIn() && request.auth.uid == uid);
        allow update: if ownsCourse(courseId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'origen', 'retiradoPor'])
          && request.resource.data.estado in ['inscrito', 'retirado'];
        // Rechazar = borrar una solicitud pendiente.
        allow delete: if ownsCourse(courseId) && resource.data.estado == 'pendiente';

        // Unirse por primera vez.
        allow create: if isOwner(uid)
          && validEnrollment(uid)
          && (joinsAsPending() || joinsFromList(courseId));

        // Volver después de un retiro. Si lo retiró el docente, siempre queda pendiente.
        allow update: if isOwner(uid)
          && resource.data.estado == 'retirado'
          && validEnrollment(uid)
          && (joinsAsPending() || (resource.data.retiradoPor == 'estudiante' && joinsFromList(courseId)));

        // Salir del curso. Las asistencias no se tocan.
        allow update: if isOwner(uid)
          && resource.data.estado == 'inscrito'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'retiradoPor'])
          && request.resource.data.estado == 'retirado'
          && request.resource.data.retiradoPor == 'estudiante';
      }
    }

    match /sesiones/{sessionId} {
      allow read: if signedIn();
      // Abrir la clase: el docente del curso, con el id "{cursoId}_{fecha de hoy}"
      // (una por día), hora del servidor y dentro del horario de la clase.
      allow create: if isTeacher()
        && request.resource.data.docenteId == request.auth.uid
        && ownsCourse(request.resource.data.cursoId)
        && sessionId == request.resource.data.cursoId + '_' + request.resource.data.fecha
        && isToday(request.resource.data.fecha)
        && inClassWindow(course(request.resource.data.cursoId))
        && request.resource.data.abierta == true
        && request.resource.data.inicio == request.time;
      // Cerrar la clase y guardar los totales; no se puede cambiar de curso, fecha ni número.
      allow update: if signedIn()
        && resource.data.docenteId == request.auth.uid
        && request.resource.data.docenteId == resource.data.docenteId
        && request.resource.data.cursoId == resource.data.cursoId
        && request.resource.data.fecha == resource.data.fecha
        && request.resource.data.numeroClase == resource.data.numeroClase
        && request.resource.data.inicio == resource.data.inicio;
      allow delete: if false;

      // Secreto y códigos vigentes: solo el docente de la sesión. getAfter() porque el
      // secreto se guarda en el mismo batch que crea la sesión.
      match /privado/{docId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/sesiones/$(sessionId)).data.docenteId == request.auth.uid;
        allow write: if signedIn()
          && getAfter(/databases/$(database)/documents/sesiones/$(sessionId)).data.docenteId == request.auth.uid;
      }

      // Asistencias: el docente ve todas y marca las manuales; el estudiante ve la suya
      // y registra la suya con el QR (solo una: el id del documento es su uid).
      match /asistencias/{uid} {
        allow create: if isOwner(uid) && validStudentAttendance(sessionId, uid);
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/sesiones/$(sessionId)).data.docenteId == request.auth.uid
          || request.auth.uid == uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/sesiones/$(sessionId)).data.docenteId == request.auth.uid
          && get(/databases/$(database)/documents/sesiones/$(sessionId)).data.abierta == true
          && request.resource.data.metodo == 'manual'
          && request.resource.data.marcadoPor == request.auth.uid
          && request.resource.data.estado == 'presente';
        allow update, delete: if false;
      }

      // Reportes de falla: el docente los ve; el estudiante envía uno por clase,
      // con la clase abierta. No marca asistencia: solo el docente decide.
      match /reportesFalla/{uid} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/sesiones/$(sessionId)).data.docenteId == request.auth.uid
          || request.auth.uid == uid);
        allow create: if isOwner(uid)
          && canActInSession(sessionId, uid)
          && request.resource.data.keys().hasOnly(['hora', 'nombre', 'codigo'])
          && request.resource.data.hora == request.time
          && request.resource.data.nombre == profile().fullName
          && request.resource.data.codigo == profile().code;
        allow update, delete: if false;
      }
    }
  }
}
